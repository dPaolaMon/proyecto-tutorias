@model ErrorViewModel
@{
    // Sin layout: la página de error no debe depender de la sesión ni de la base de datos
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Titulo - Tutorías IPN-UPIICSA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-ipn-gris-claro d-flex align-items-center min-vh-100">
    <main class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5">
                <div class="card border-0 shadow-sm rounded-3 text-center p-4">
                    <h1 class="h4 fw-bold text-ipn-guinda mb-3">@Model.Titulo</h1>
                    <p class="text-ipn-gris mb-4">@Model.Mensaje</p>
                    @if (Model.ShowRequestId)
                    {
                        <p class="small text-muted">Identificador para soporte: <code>@Model.RequestId</code></p>
                    }
                    <a class="btn btn-ipn-guinda fw-semibold" href="~/">Volver al inicio</a>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
