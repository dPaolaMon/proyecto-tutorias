@using Microsoft.AspNetCore.Identity
@using tutorias.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tutorías IPN-UPIICSA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm bg-ipn-guinda">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    Tutorías IPN-UPIICSA
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white active" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (!User.IsInRole("Tutor") && !User.IsInRole("Coordinador"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-white fw-semibold" href="#" id="tutoriasAlumnoDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Tutorías
                                    </a>
                                    <ul class="dropdown-menu shadow border-0" aria-labelledby="tutoriasAlumnoDropdown">
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Catalogo" asp-action="Index">
                                                <i class="bi bi-grid me-2 text-ipn-guinda"></i> Catálogo de Tutorías
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Asistencia" asp-action="MisAsistencias">
                                                <i class="bi bi-calendar-check me-2 text-ipn-guinda"></i> Mis Asistencias
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold" asp-controller="Tutorias" asp-action="Solicitud">
                                        <i class="bi bi-mortarboard me-1"></i> Solicitud de Tutor
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Catalogo" asp-action="Index">
                                        Catálogo de Tutorías
                                    </a>
                                </li>
                            }
                        }
                        @if (User.IsInRole("Tutor"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-semibold" href="#" id="tutorGestionDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Gestión de Tutorías
                                </a>
                                <ul class="dropdown-menu shadow border-0" aria-labelledby="tutorGestionDropdown">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Asistencia" asp-action="Index">
                                            <i class="bi bi-card-checklist me-2 text-ipn-guinda"></i> Pase de Lista
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="TutorPerfil" asp-action="Index">
                                            <i class="bi bi-clock-history me-2 text-ipn-guinda"></i> Panel de Horarios y Ubicaciones
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Asistencia" asp-action="MisAsistencias">
                                            <i class="bi bi-calendar-check me-2 text-ipn-guinda"></i> Mis Asistencias como Alumno
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Notificacion" asp-action="Enviar">
                                            <i class="bi bi-send me-2 text-ipn-guinda"></i> Enviar Notificación
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Coordinador"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-semibold" href="#" id="coordinacionDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Coordinación
                                </a>
                                <ul class="dropdown-menu shadow border-0" aria-labelledby="coordinacionDropdown">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Coordinacion" asp-action="Index">
                                            <i class="bi bi-people me-2 text-ipn-guinda"></i> Gestión de Usuarios
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Coordinacion" asp-action="SolicitudesTutores">
                                            <i class="bi bi-person-lines-fill me-2 text-ipn-guinda"></i> Solicitudes de Tutor
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Coordinacion" asp-action="Encuestas">
                                            <i class="bi bi-bar-chart-line me-2 text-ipn-guinda"></i> Indicadores y Encuestas
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Notificacion" asp-action="Enviar">
                                            <i class="bi bi-send me-2 text-ipn-guinda"></i> Enviar Notificación
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Tutor") || User.IsInRole("Coordinador"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-semibold" href="#" id="reportesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Reportes
                                </a>
                                <ul class="dropdown-menu shadow border-0" aria-labelledby="reportesDropdown">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Reportes" asp-action="Diario">
                                            <i class="bi bi-calendar-day me-2 text-ipn-guinda"></i> Reporte Diario
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Reportes" asp-action="Mensual">
                                            <i class="bi bi-calendar-month me-2 text-ipn-guinda"></i> Reporte Mensual
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <!-- Campana de Notificaciones a un lado del menú con el avatar -->
                            <li class="nav-item dropdown me-2">
                                <a class="nav-link position-relative d-inline-flex align-items-center justify-content-center p-0 shadow-sm"
                                   href="#" id="notificacionesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notificaciones"
                                   style="width: 32px; height: 32px; border-radius: 50%; background-color: #ffffff; color: #750946;">
                                    <i class="bi bi-bell-fill" style="font-size: 0.95rem; color: #750946;"></i>
                                    <span id="badgeNotificaciones" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white d-none" style="font-size:0.65rem;">
                                        0
                                    </span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0 mt-1" aria-labelledby="notificacionesDropdown" style="width: 340px; max-width: 90vw;">
                                    <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0 fw-bold text-dark fs-6">
                                            <i class="bi bi-bell-fill text-ipn-guinda me-1"></i> Notificaciones
                                        </h6>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small text-ipn-guinda fw-semibold" id="btnMarcarTodasLeidas">
                                            Marcar leídas
                                        </button>
                                    </div>
                                    <div id="listaNotificacionesContenedor" style="max-height: 360px; overflow-y: auto;">
                                        <div class="text-center py-4 text-muted small">
                                            <div class="spinner-border spinner-border-sm text-secondary mb-2" role="status"></div>
                                            <div>Cargando notificaciones...</div>
                                        </div>
                                    </div>
                                    <div class="p-2 text-center border-top bg-white">
                                        <small class="text-muted" style="font-size: 0.75rem;">Avisos oficiales y seguimiento institucional</small>
                                    </div>
                                </div>
                            </li>

                            var user = await UserManager.GetUserAsync(User);
                            var displayName = !string.IsNullOrWhiteSpace(user?.NombreCompleto)
                                ? user.NombreCompleto
                                : (!string.IsNullOrWhiteSpace(user?.Nombre) ? user.Nombre : (user?.Email ?? User.Identity?.Name ?? "Usuario"));
                            var initial = !string.IsNullOrWhiteSpace(displayName) ? displayName.Trim().Substring(0, 1).ToUpper() : "?";
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2"
                                   href="#" id="userDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="rounded-circle bg-white d-inline-flex align-items-center justify-content-center fw-bold text-ipn-guinda"
                                          style="width:30px;height:30px;font-size:.85rem;flex-shrink:0;">
                                        @initial
                                    </span>
                                    <span class="d-none d-lg-inline text-truncate" style="max-width:160px;">
                                        @displayName
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-1"
                                    aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person me-2"></i> Mi Perfil
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Tutor"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 fw-semibold text-ipn-guinda" asp-controller="Asistencia" asp-action="GenerarQr">
                                                <i class="bi bi-qr-code me-2"></i> Proyectar Codigo QR
                                            </a>
                                        </li>
                                    }
                                    else if (!User.IsInRole("Coordinador"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 fw-semibold text-ipn-guinda" asp-controller="Asistencia" asp-action="Escanear">
                                                <i class="bi bi-qr-code-scan me-2"></i> Escanear Codigo QR
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2 mb-2 mb-lg-0">
                                <a class="btn btn-outline-light btn-sm w-100 fw-semibold" asp-controller="Account" asp-action="Login">
                                    Iniciar Sesión
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-light text-ipn-guinda btn-sm w-100 fw-semibold" asp-controller="Account" asp-action="Register">
                                    Registrarme
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 py-4">
        <main role="main" class="pb-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                    <span>@TempData["SuccessMessage"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                    <span>@TempData["WarningMessage"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                    <span>@TempData["ErrorMessage"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
        <div class="container">
            &copy; 2026 Instituto Politécnico Nacional — Sistema de Tutorías Académicas
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (SignInManager.IsSignedIn(User))
    {
        <form id="antiForgeryFormNotif" style="display:none;">
            @Html.AntiForgeryToken()
        </form>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const badge = document.getElementById("badgeNotificaciones");
                const contenedor = document.getElementById("listaNotificacionesContenedor");
                const btnMarcarTodas = document.getElementById("btnMarcarTodasLeidas");
                const notifDropdown = document.getElementById("notificacionesDropdown");
                const tokenInput = document.querySelector("#antiForgeryFormNotif input[name='__RequestVerificationToken']");
                const token = tokenInput ? tokenInput.value : "";

                async function cargarNotificaciones() {
                    try {
                        const response = await fetch("@Url.Action("Campana", "Notificacion")");
                        if (!response.ok) return;
                        const data = await response.json();

                        if (badge) {
                            if (data.totalNoLeidas > 0) {
                                badge.textContent = data.totalNoLeidas > 99 ? "99+" : data.totalNoLeidas;
                                badge.classList.remove("d-none");
                            } else {
                                badge.classList.add("d-none");
                            }
                        }

                        if (contenedor) {
                            if (!data.notificaciones || data.notificaciones.length === 0) {
                                contenedor.innerHTML = `
                                    <div class="text-center py-5 text-muted small px-3">
                                        <i class="bi bi-bell-slash fs-2 text-secondary mb-2 d-block"></i>
                                        <p class="mb-0 fw-semibold text-dark">Sin notificaciones</p>
                                        <span class="text-muted">No tienes mensajes ni avisos pendientes.</span>
                                    </div>`;
                                return;
                            }

                            let html = `<div class="list-group list-group-flush">`;
                            data.notificaciones.forEach(n => {
                                const bgClass = n.leida ? "bg-white" : "bg-light border-start border-3 border-danger";
                                html += `
                                    <div class="list-group-item p-3 ${bgClass} item-notificacion" data-id="${n.id}">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <h6 class="fw-bold text-dark mb-0 fs-6 text-truncate" style="max-width: 220px;">
                                                ${escapeHtml(n.titulo)}
                                            </h6>
                                            <span class="text-muted" style="font-size: 0.7rem;">${escapeHtml(n.tiempoRelativo)}</span>
                                        </div>
                                        <p class="text-secondary small mb-2 text-break" style="font-size: 0.8rem; line-height: 1.3;">
                                            ${escapeHtml(n.mensaje)}
                                        </p>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.65rem;">
                                                ${escapeHtml(n.emisorRol)}: ${escapeHtml(n.emisorNombre)}
                                            </span>
                                            ${!n.leida ? `<button type="button" class="btn btn-link p-0 text-decoration-none text-muted small btn-marcar-individual" data-id="${n.id}" style="font-size: 0.7rem;">Marcar leída</button>` : `<span class="text-success small" style="font-size: 0.65rem;"><i class="bi bi-check2"></i> Leída</span>`}
                                        </div>
                                    </div>`;
                            });
                            html += `</div>`;
                            contenedor.innerHTML = html;

                            contenedor.querySelectorAll(".btn-marcar-individual").forEach(btn => {
                                btn.addEventListener("click", async (e) => {
                                    e.stopPropagation();
                                    const notifId = btn.getAttribute("data-id");
                                    const formData = new FormData();
                                    formData.append("id", notifId);
                                    formData.append("__RequestVerificationToken", token);

                                    await fetch("@Url.Action("MarcarLeida", "Notificacion")", {
                                        method: "POST",
                                        body: formData
                                    });
                                    cargarNotificaciones();
                                });
                            });
                        }
                    } catch (err) {
                        console.error("Error al cargar notificaciones:", err);
                    }
                }

                function escapeHtml(text) {
                    if (!text) return "";
                    return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
                }

                if (btnMarcarTodas) {
                    btnMarcarTodas.addEventListener("click", async (e) => {
                        e.stopPropagation();
                        const formData = new FormData();
                        formData.append("__RequestVerificationToken", token);

                        await fetch("@Url.Action("MarcarTodasLeidas", "Notificacion")", {
                            method: "POST",
                            body: formData
                        });
                        cargarNotificaciones();
                    });
                }

                if (notifDropdown) {
                    notifDropdown.addEventListener("show.bs.dropdown", cargarNotificaciones);
                }

                cargarNotificaciones();
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
