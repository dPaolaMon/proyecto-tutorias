@model tutorias.Models.ViewModels.GestionUsuariosViewModel
@{
    ViewData["Title"] = "Gestión de Usuarios y Coordinación";
}

<div class="container-fluid px-0">
    <!-- Encabezado y KPIs -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-12 col-md-7">
            <h1 class="h3 fw-bold text-ipn-guinda mb-1">
                Gestión de Usuarios y Coordinación
            </h1>
            <p class="text-muted mb-0 small">
                Consulta perfiles institucionales, audita el estado de las cuentas y gestiona los permisos del rol Coordinador.
            </p>
        </div>
        <div class="col-12 col-md-5">
            <div class="d-flex gap-2 justify-content-md-end">
                <div class="card border-0 shadow-sm px-3 py-2 text-center bg-white">
                    <span class="text-muted small">Total Cuentas</span>
                    <span class="fs-5 fw-bold text-dark">@Model.TotalUsuarios</span>
                </div>
                <div class="card border-0 shadow-sm px-3 py-2 text-center bg-white">
                    <span class="text-muted small">Coordinadores</span>
                    <span class="fs-5 fw-bold text-ipn-guinda">@Model.TotalCoordinadores</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Navegación entre módulos de Coordinación -->
    <div class="mb-4">
        <ul class="nav nav-pills gap-2 bg-white p-2 rounded-3 shadow-sm d-inline-flex border">
            <li class="nav-item">
                <a class="nav-link active bg-ipn-guinda text-white fw-semibold py-1 px-3" asp-action="Index">
                    Gestión de Usuarios
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-muted fw-semibold py-1 px-3" asp-action="SolicitudesTutores">
                    Solicitudes de Tutores
                </a>
            </li>
        </ul>
    </div>

    <!-- Barra de Filtros -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-6 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search text-muted" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
                            </svg>
                        </span>
                        <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control border-start-0" placeholder="Buscar por nombre, correo o boleta..." />
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <select name="rolFiltro" class="form-select">
                        <option value="Todos" selected="@(string.IsNullOrEmpty(Model.RolFiltro) || Model.RolFiltro == "Todos")">Filtrar por rol: Todos</option>
                        <option value="Coordinador" selected="@(Model.RolFiltro == "Coordinador")">Coordinadores</option>
                        <option value="Docente" selected="@(Model.RolFiltro == "Docente")">Docentes</option>
                        <option value="Alumno" selected="@(Model.RolFiltro == "Alumno")">Alumnos</option>
                        <option value="Tutor" selected="@(Model.RolFiltro == "Tutor")">Tutores</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-2 col-lg-4 d-flex gap-2">
                    <button type="submit" class="btn btn-ipn-guinda fw-semibold px-3">
                        Filtrar
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || (!string.IsNullOrWhiteSpace(Model.RolFiltro) && Model.RolFiltro != "Todos"))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary px-3">
                            Limpiar
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Mensajes de Alerta -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Tabla de Usuarios -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            @if (Model.Usuarios.Count == 0)
            {
                <div class="p-5 text-center text-muted">
                    <p class="mb-1 fs-5">No se encontraron usuarios coincidentes.</p>
                    <small>Intenta modificar los criterios de búsqueda o limpiar los filtros.</small>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4">Nombre</th>
                                <th>Boleta</th>
                                <th>Correo Institucional</th>
                                <th>Carrera / Academia</th>
                                <th>Roles</th>
                                <th>Estatus</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Usuarios)
                            {
                                <tr class="@(!user.Activo ? "table-light text-muted" : "")">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(user.FotoUrl))
                                            {
                                                <img src="@user.FotoUrl" class="rounded-circle" style="width: 36px; height: 36px; object-fit: cover;" alt="Avatar" />
                                            }
                                            else
                                            {
                                                <span class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center text-ipn-guinda fw-bold border" style="width: 36px; height: 36px; font-size: 0.85rem;">
                                                    @(!string.IsNullOrWhiteSpace(user.Nombre) ? user.Nombre.Substring(0, 1).ToUpper() : (!string.IsNullOrWhiteSpace(user.NombreCompleto) ? user.NombreCompleto.Substring(0, 1).ToUpper() : "?"))
                                                </span>
                                            }
                                            <div>
                                                <div class="fw-semibold text-dark">
                                                    @user.NombreCompleto
                                                    @if (user.EsUsuarioActual)
                                                    {
                                                        <span class="badge bg-secondary ms-1 small" style="font-size: 0.65rem;">Tú</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="font-monospace small">@user.Boleta</span>
                                    </td>
                                    <td>
                                        <span class="small">@user.Email</span>
                                        @if (user.EmailConfirmed)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill ms-1" style="font-size: 0.65rem;">Verificado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill ms-1" style="font-size: 0.65rem;">Pendiente</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="small text-muted">@user.InformacionAcademica</span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var rol in user.Roles)
                                            {
                                                if (rol == "Coordinador")
                                                {
                                                    <span class="badge bg-ipn-guinda">@rol</span>
                                                }
                                                else if (rol == "Tutor")
                                                {
                                                    <span class="badge bg-purple text-white" style="background-color: #6f42c1;">@rol</span>
                                                }
                                                else if (rol == "Docente")
                                                {
                                                    <span class="badge bg-primary">@rol</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">@rol</span>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (user.Activo)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Activa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="Motivo: @user.MotivoBaja">Dada de baja</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            <!-- Botón Ver Ficha -->
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-ver-ficha"
                                                    data-bs-toggle="modal" data-bs-target="#modalFichaUsuario"
                                                    data-nombre="@user.NombreCompleto"
                                                    data-boleta="@user.Boleta"
                                                    data-email="@user.Email"
                                                    data-emailconfirmed="@(user.EmailConfirmed ? "true" : "false")"
                                                    data-academica="@user.InformacionAcademica"
                                                    data-roles="@string.Join(", ", user.Roles)"
                                                    data-activo="@(user.Activo ? "true" : "false")"
                                                    data-fechabaja="@(user.FechaBaja?.ToString("dd/MM/yyyy HH:mm") ?? "")"
                                                    data-motivobaja="@(user.MotivoBaja ?? "")"
                                                    data-tipotutor="@user.TipoTutor.ToString()"
                                                    data-fotourl="@(user.FotoUrl ?? "")">
                                                Ficha
                                            </button>

                                            <!-- Botón Promover o Revocar Coordinador -->
                                            @if (user.EsCoordinador)
                                            {
                                                if (user.EsUsuarioActual)
                                                {
                                                    <button type="button" class="btn btn-sm btn-light border text-muted" disabled title="No puedes revocar tus propios privilegios de Coordinador.">
                                                        Coordinador
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger btn-abrir-revocar"
                                                            data-bs-toggle="modal" data-bs-target="#modalRevocar"
                                                            data-id="@user.Id"
                                                            data-nombre="@user.NombreCompleto">
                                                        Revocar Rol
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-ipn-guinda btn-abrir-promover"
                                                        data-bs-toggle="modal" data-bs-target="#modalPromover"
                                                        data-id="@user.Id"
                                                        data-nombre="@user.NombreCompleto"
                                                        disabled="@(!user.Activo || !user.EmailConfirmed)"
                                                        title="@(!user.EmailConfirmed ? "El usuario debe verificar su correo primero." : (!user.Activo ? "Cuenta inactiva." : "Promover a Coordinador"))">
                                                    Asignar Coordinador
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPaginas > 1)
                {
                    <div class="p-3 border-top d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                        <span class="text-muted small">
                            Mostrando página @Model.PaginaActual de @Model.TotalPaginas (@Model.TotalRegistros registros en total)
                        </span>
                        <nav aria-label="Navegación de páginas">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-busqueda="@Model.Busqueda"
                                       asp-route-rolFiltro="@Model.RolFiltro"
                                       asp-route-pagina="@(Model.PaginaActual - 1)"
                                       aria-label="Anterior">
                                        &laquo; Anterior
                                    </a>
                                </li>
                                @for (int p = 1; p <= Model.TotalPaginas; p++)
                                {
                                    <li class="page-item @(p == Model.PaginaActual ? "active" : "")">
                                        <a class="page-link @(p == Model.PaginaActual ? "bg-ipn-guinda border-ipn-guinda text-white" : "text-dark")"
                                           asp-action="Index"
                                           asp-route-busqueda="@Model.Busqueda"
                                           asp-route-rolFiltro="@Model.RolFiltro"
                                           asp-route-pagina="@p">
                                            @p
                                        </a>
                                    </li>
                                }
                                <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-busqueda="@Model.Busqueda"
                                       asp-route-rolFiltro="@Model.RolFiltro"
                                       asp-route-pagina="@(Model.PaginaActual + 1)"
                                       aria-label="Siguiente">
                                        Siguiente &raquo;
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 1: FICHA TÉCNICA DEL USUARIO        -->
<!-- ========================================== -->
<div class="modal fade" id="modalFichaUsuario" tabindex="-1" aria-labelledby="modalFichaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-ipn-guinda" id="modalFichaLabel">
                    Ficha del Usuario Institucional
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div id="fichaAvatarContainer" class="d-inline-block mb-2">
                        <span id="fichaAvatarText" class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center text-ipn-guinda fw-bold border shadow-sm" style="width: 64px; height: 64px; font-size: 1.5rem;"></span>
                        <img id="fichaAvatarImg" class="rounded-circle d-none shadow-sm" style="width: 64px; height: 64px; object-fit: cover;" alt="Avatar" />
                    </div>
                    <h5 id="fichaNombre" class="fw-bold text-dark mb-1"></h5>
                    <p id="fichaBoleta" class="text-muted small font-monospace mb-0"></p>
                </div>

                <div class="list-group list-group-flush rounded-3 border">
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small fw-medium">Correo Institucional</span>
                        <span class="small fw-semibold text-end" id="fichaEmail"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small fw-medium">Verificación de Correo</span>
                        <span id="fichaEmailConfirmed"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small fw-medium">Carrera / Academia</span>
                        <span class="small fw-semibold text-end" id="fichaAcademica"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small fw-medium">Roles en Plataforma</span>
                        <span class="small fw-semibold text-end" id="fichaRoles"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small fw-medium">Estatus de Tutor</span>
                        <span class="small fw-semibold text-end" id="fichaTipoTutor"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small fw-medium">Estado de Cuenta</span>
                        <span id="fichaActivo"></span>
                    </div>
                </div>

                <!-- Detalle de baja lógica si aplica -->
                <div id="fichaAlertaBaja" class="alert alert-danger border-danger small mt-3 mb-0 d-none">
                    <div class="fw-bold mb-1">Cuenta dada de baja</div>
                    <div><strong>Fecha:</strong> <span id="fichaFechaBaja"></span></div>
                    <div><strong>Motivo registrado:</strong> <span id="fichaMotivoBaja"></span></div>
                </div>
            </div>
            <div class="modal-footer bg-light border-top-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 2: CONFIRMAR PROMOCIÓN A COORDINADOR -->
<!-- ========================================== -->
<div class="modal fade" id="modalPromover" tabindex="-1" aria-labelledby="modalPromoverLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Promover" method="post">
                <input type="hidden" name="id" id="promoverUserId" />
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-ipn-guinda" id="modalPromoverLabel">
                        Promover a Coordinador
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-3">
                        ¿Confirmas que deseas otorgar privilegios de <strong>Coordinador</strong> a <span id="promoverNombre" class="fw-bold text-dark"></span>?
                    </p>
                    <div class="alert alert-light border small text-muted mb-0">
                        <div class="fw-semibold text-dark mb-1">Privilegios asignados:</div>
                        <ul class="mb-0 ps-3">
                            <li>Recepción, aprobación y rechazo de solicitudes de tutores.</li>
                            <li>Gestión y auditoría de cuentas de usuarios.</li>
                            <li>Generación y descarga de reportes y métricas de asistencia.</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-ipn-guinda fw-semibold">
                        Confirmar Promoción
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 3: CONFIRMAR REVOCACIÓN DE COORDINADOR-->
<!-- ========================================== -->
<div class="modal fade" id="modalRevocar" tabindex="-1" aria-labelledby="modalRevocarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Revocar" method="post">
                <input type="hidden" name="id" id="revocarUserId" />
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger" id="modalRevocarLabel">
                        Revocar Rol de Coordinador
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-3">
                        ¿Estás seguro de que deseas retirar los permisos de Coordinador a <span id="revocarNombre" class="fw-bold text-dark"></span>?
                    </p>
                    <div class="alert alert-warning border small text-dark mb-0">
                        El usuario perderá de forma inmediata el acceso al panel administrativo de Coordinación, bandeja de tutores y reportes ejecutivos.
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger fw-semibold">
                        Confirmar Revocación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Ficha del usuario
            document.querySelectorAll('.btn-ver-ficha').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var nombre = this.getAttribute('data-nombre');
                    var boleta = this.getAttribute('data-boleta');
                    var email = this.getAttribute('data-email');
                    var emailConfirmed = this.getAttribute('data-emailconfirmed') === 'true';
                    var academica = this.getAttribute('data-academica');
                    var roles = this.getAttribute('data-roles');
                    var activo = this.getAttribute('data-activo') === 'true';
                    var fechaBaja = this.getAttribute('data-fechabaja');
                    var motivoBaja = this.getAttribute('data-motivobaja');
                    var tipoTutor = this.getAttribute('data-tipotutor');
                    var fotoUrl = this.getAttribute('data-fotourl');

                    document.getElementById('fichaNombre').textContent = nombre;
                    document.getElementById('fichaBoleta').textContent = 'Boleta: ' + boleta;
                    document.getElementById('fichaEmail').textContent = email;
                    document.getElementById('fichaAcademica').textContent = academica;
                    document.getElementById('fichaRoles').textContent = roles;

                    var tipoTutorTexto = (tipoTutor === 'Ninguno' || !tipoTutor) ? 'No es tutor' : (tipoTutor === 'AlumnoTutor' ? 'Alumno Tutor (Pares)' : 'Docente Tutor (Individual)');
                    document.getElementById('fichaTipoTutor').textContent = tipoTutorTexto;

                    // Email confirmed badge
                    var elEmailConf = document.getElementById('fichaEmailConfirmed');
                    if (emailConfirmed) {
                        elEmailConf.innerHTML = '<span class="badge bg-success-subtle text-success border border-success-subtle">Verificado</span>';
                    } else {
                        elEmailConf.innerHTML = '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Pendiente de verificación</span>';
                    }

                    // Activo badge
                    var elActivo = document.getElementById('fichaActivo');
                    var elAlertaBaja = document.getElementById('fichaAlertaBaja');
                    if (activo) {
                        elActivo.innerHTML = '<span class="badge bg-success-subtle text-success border border-success-subtle">Activa</span>';
                        elAlertaBaja.classList.add('d-none');
                    } else {
                        elActivo.innerHTML = '<span class="badge bg-danger-subtle text-danger border border-danger-subtle">Dada de baja</span>';
                        elAlertaBaja.classList.remove('d-none');
                        document.getElementById('fichaFechaBaja').textContent = fechaBaja || 'No registrada';
                        document.getElementById('fichaMotivoBaja').textContent = motivoBaja || 'Sin motivo especificado';
                    }

                    // Avatar
                    var elAvatarText = document.getElementById('fichaAvatarText');
                    var elAvatarImg = document.getElementById('fichaAvatarImg');
                    if (fotoUrl && fotoUrl.trim() !== '') {
                        elAvatarImg.src = fotoUrl;
                        elAvatarImg.classList.remove('d-none');
                        elAvatarText.classList.add('d-none');
                    } else {
                        elAvatarText.textContent = (nombre && nombre.length > 0) ? nombre.charAt(0).toUpperCase() : '?';
                        elAvatarText.classList.remove('d-none');
                        elAvatarImg.classList.add('d-none');
                    }
                });
            });

            // Modal Promover
            document.querySelectorAll('.btn-abrir-promover').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.getAttribute('data-id');
                    var nombre = this.getAttribute('data-nombre');
                    document.getElementById('promoverUserId').value = id;
                    document.getElementById('promoverNombre').textContent = nombre;
                });
            });

            // Modal Revocar
            document.querySelectorAll('.btn-abrir-revocar').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.getAttribute('data-id');
                    var nombre = this.getAttribute('data-nombre');
                    document.getElementById('revocarUserId').value = id;
                    document.getElementById('revocarNombre').textContent = nombre;
                });
            });
        });
    </script>
}
