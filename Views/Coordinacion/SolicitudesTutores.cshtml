@model tutorias.Models.ViewModels.BandejaSolicitudesViewModel
@using tutorias.Models
@{
    ViewData["Title"] = "Bandeja de Solicitudes de Tutores";
}

<div class="container-fluid px-0">
    <!-- Encabezado y KPIs -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-12 col-md-7">
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold text-ipn-guinda mb-0">
                    Bandeja de Solicitudes de Tutores
                </h1>
            </div>
            <p class="text-muted mb-0 small">
                Revisa y dictamina las solicitudes de alta de tutores (Tutoría entre Pares y Tutoría Individual) para activar su perfil académico.
            </p>
        </div>
        <div class="col-12 col-md-5">
            <div class="d-flex gap-2 justify-content-md-end flex-wrap">
                <div class="card border-0 shadow-sm px-3 py-2 text-center bg-white">
                    <span class="text-muted small">Pendientes</span>
                    <span class="fs-5 fw-bold text-warning-emphasis">@Model.TotalPendientes</span>
                </div>
                <div class="card border-0 shadow-sm px-3 py-2 text-center bg-white">
                    <span class="text-muted small">Aprobadas</span>
                    <span class="fs-5 fw-bold text-success">@Model.TotalAprobadas</span>
                </div>
                <div class="card border-0 shadow-sm px-3 py-2 text-center bg-white">
                    <span class="text-muted small">Rechazadas</span>
                    <span class="fs-5 fw-bold text-danger">@Model.TotalRechazadas</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Navegación entre módulos de Coordinación -->
    <div class="mb-4">
        <ul class="nav nav-pills gap-2 bg-white p-2 rounded-3 shadow-sm d-inline-flex border">
            <li class="nav-item">
                <a class="nav-link text-muted fw-semibold py-1 px-3" asp-action="Index">
                    Gestión de Usuarios
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active bg-ipn-guinda text-white fw-semibold py-1 px-3" asp-action="SolicitudesTutores">
                    Solicitudes de Tutores
                    @if (Model.TotalPendientes > 0)
                    {
                        <span class="badge bg-white text-ipn-guinda ms-1">@Model.TotalPendientes</span>
                    }
                </a>
            </li>
        </ul>
    </div>

    <!-- Barra de Búsqueda y Filtros -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="SolicitudesTutores" class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search text-muted" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
                            </svg>
                        </span>
                        <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control border-start-0" placeholder="Buscar por nombre, correo o boleta..." />
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <select name="rolFiltro" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.RolFiltro))">Modalidad: Todas</option>
                        <option value="Alumno" selected="@(Model.RolFiltro == "Alumno")">Tutoría entre Pares (Alumnos)</option>
                        <option value="Docente" selected="@(Model.RolFiltro == "Docente")">Tutoría Individual (Docentes)</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-2">
                    <select name="estadoFiltro" class="form-select">
                        <option value="" selected="@(!Model.EstadoFiltro.HasValue)">Estado: Todos</option>
                        <option value="Pendiente" selected="@(Model.EstadoFiltro == EstadoSolicitud.Pendiente)">Pendientes</option>
                        <option value="Aprobada" selected="@(Model.EstadoFiltro == EstadoSolicitud.Aprobada)">Aprobadas</option>
                        <option value="Rechazada" selected="@(Model.EstadoFiltro == EstadoSolicitud.Rechazada)">Rechazadas</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-ipn-guinda fw-semibold px-3 w-100">
                        Filtrar
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || !string.IsNullOrWhiteSpace(Model.RolFiltro) || Model.EstadoFiltro.HasValue)
                    {
                        <a asp-action="SolicitudesTutores" class="btn btn-outline-secondary px-3" title="Limpiar filtros">
                            Limpiar
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Contenido de Solicitudes -->
    @if (!Model.Solicitudes.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 text-center p-5 bg-white">
            <div class="py-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-inbox text-muted mb-3" viewBox="0 0 16 16">
                    <path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zm9.954 5H10.45a2.5 2.5 0 0 1-4.9 0H1.066l.32 2.562a.5.5 0 0 0 .497.438h12.234a.5.5 0 0 0 .496-.438zM3.809 3.563A1.5 1.5 0 0 1 4.981 3h6.038a1.5 1.5 0 0 1 1.172.563l3.7 4.625a1 1 0 0 1 .109.846l-.547 4.375A1.5 1.5 0 0 1 13.967 15H2.033a1.5 1.5 0 0 1-1.486-1.591l-.547-4.375a1 1 0 0 1 .109-.846z"/>
                </svg>
                <h5 class="fw-bold text-dark mb-1">No se encontraron solicitudes</h5>
                <p class="text-muted small mb-0">No hay registros que coincidan con los filtros seleccionados.</p>
            </div>
        </div>
    }
    else
    {
        <!-- Vista de Tarjetas para Móvil y Tabla para Escritorio -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="table-responsive d-none d-lg-block">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-4">Solicitante</th>
                            <th>Boleta</th>
                            <th>Programa / Academia</th>
                            <th>Modalidad</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Solicitudes)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@s.NombreCompleto</div>
                                    <div class="small text-muted text-break">@s.Email</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@s.Boleta</span>
                                </td>
                                <td>
                                    <span class="small text-muted">@s.ProgramaOAcademia</span>
                                </td>
                                <td>
                                    <span class="badge @(s.EsDocente ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-info-subtle text-info-emphasis border border-info-subtle")">
                                        @s.ModalidadDescripcion
                                    </span>
                                </td>
                                <td>
                                    <span class="small text-muted">@s.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td>
                                    @switch (s.Estado)
                                    {
                                        case EstadoSolicitud.Pendiente:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Pendiente</span>
                                            break;
                                        case EstadoSolicitud.Aprobada:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Aprobada</span>
                                            break;
                                        case EstadoSolicitud.Rechazada:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="@s.RespuestaCoordinacion">Rechazada</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-1">
                                        @if (s.Estado == EstadoSolicitud.Pendiente)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success fw-semibold"
                                                    data-bs-toggle="modal" data-bs-target="#modalAprobar_@s.Id" title="Aprobar solicitud">
                                                Aprobar
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger fw-semibold"
                                                    data-bs-toggle="modal" data-bs-target="#modalRechazar_@s.Id" title="Rechazar solicitud">
                                                Rechazar
                                            </button>
                                        }
                                        else if (s.Estado == EstadoSolicitud.Aprobada && s.EsTutorActivo)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger fw-semibold"
                                                    data-bs-toggle="modal" data-bs-target="#modalSuspender_@s.UserId" title="Suspender tutor">
                                                Suspender
                                            </button>
                                        }
                                        else if (s.Estado == EstadoSolicitud.Rechazada)
                                        {
                                            <span class="small text-muted fst-italic">Dictaminada</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Vista Móvil en Cards -->
            <div class="d-lg-none p-3">
                <div class="row g-3">
                    @foreach (var s in Model.Solicitudes)
                    {
                        <div class="col-12">
                            <div class="card border rounded-3 p-3 shadow-none">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">@s.NombreCompleto</h6>
                                        <span class="small text-muted text-break">@s.Email</span>
                                    </div>
                                    @switch (s.Estado)
                                    {
                                        case EstadoSolicitud.Pendiente:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Pendiente</span>
                                            break;
                                        case EstadoSolicitud.Aprobada:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Aprobada</span>
                                            break;
                                        case EstadoSolicitud.Rechazada:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Rechazada</span>
                                            break;
                                    }
                                </div>
                                <div class="small text-muted mb-2">
                                    <div><strong>Boleta:</strong> @s.Boleta</div>
                                    <div><strong>Adscripción:</strong> @s.ProgramaOAcademia</div>
                                    <div><strong>Modalidad:</strong> @s.ModalidadDescripcion</div>
                                    <div><strong>Fecha:</strong> @s.FechaSolicitud.ToLocalTime().ToString("g")</div>
                                </div>
                                <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                                    @if (s.Estado == EstadoSolicitud.Pendiente)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success fw-semibold"
                                                data-bs-toggle="modal" data-bs-target="#modalAprobar_@s.Id">
                                            Aprobar
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger fw-semibold"
                                                data-bs-toggle="modal" data-bs-target="#modalRechazar_@s.Id">
                                            Rechazar
                                        </button>
                                    }
                                    else if (s.Estado == EstadoSolicitud.Aprobada && s.EsTutorActivo)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger fw-semibold"
                                                data-bs-toggle="modal" data-bs-target="#modalSuspender_@s.UserId">
                                            Suspender
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Paginación -->
            @if (Model.TotalPaginas > 1)
            {
                <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="small text-muted">
                        Página @Model.PaginaActual de @Model.TotalPaginas (Total: @Model.TotalRegistros)
                    </span>
                    <nav aria-label="Navegación de solicitudes">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : "")">
                                <a class="page-link" asp-action="SolicitudesTutores"
                                   asp-route-pagina="@(Model.PaginaActual - 1)"
                                   asp-route-busqueda="@Model.Busqueda"
                                   asp-route-rolFiltro="@Model.RolFiltro"
                                   asp-route-estadoFiltro="@Model.EstadoFiltro">Anterior</a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPaginas; p++)
                            {
                                <li class="page-item @(p == Model.PaginaActual ? "active" : "")">
                                    <a class="page-link @(p == Model.PaginaActual ? "bg-ipn-guinda border-0" : "")"
                                       asp-action="SolicitudesTutores"
                                       asp-route-pagina="@p"
                                       asp-route-busqueda="@Model.Busqueda"
                                       asp-route-rolFiltro="@Model.RolFiltro"
                                       asp-route-estadoFiltro="@Model.EstadoFiltro">@p</a>
                                </li>
                            }
                            <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : "")">
                                <a class="page-link" asp-action="SolicitudesTutores"
                                   asp-route-pagina="@(Model.PaginaActual + 1)"
                                   asp-route-busqueda="@Model.Busqueda"
                                   asp-route-rolFiltro="@Model.RolFiltro"
                                   asp-route-estadoFiltro="@Model.EstadoFiltro">Siguiente</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    }
</div>

<!-- Modales de Confirmación para cada Solicitud -->
@foreach (var s in Model.Solicitudes)
{
    @if (s.Estado == EstadoSolicitud.Pendiente)
    {
        <!-- Modal Aprobar -->
        <div class="modal fade" id="modalAprobar_@s.Id" tabindex="-1" aria-labelledby="labelAprobar_@s.Id" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title fw-bold" id="labelAprobar_@s.Id">Aprobar Solicitud de Tutor</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <form asp-action="AprobarSolicitud" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@s.Id" />
                        <div class="modal-body p-4">
                            <p class="text-muted small mb-3">
                                Al aprobar esta solicitud, se asignará el rol <strong>Tutor</strong> al usuario y se habilitará la creación de su perfil académico y administración de horarios.
                            </p>
                            <div class="bg-light p-3 rounded-3 small">
                                <div><strong>Solicitante:</strong> @s.NombreCompleto</div>
                                <div><strong>Boleta:</strong> @s.Boleta</div>
                                <div><strong>Modalidad:</strong> @s.ModalidadDescripcion</div>
                                <div><strong>Adscripción:</strong> @s.ProgramaOAcademia</div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light border-0">
                            <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-success btn-sm fw-semibold px-3">Confirmar y Aprobar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Modal Rechazar -->
        <div class="modal fade" id="modalRechazar_@s.Id" tabindex="-1" aria-labelledby="labelRechazar_@s.Id" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title fw-bold" id="labelRechazar_@s.Id">Rechazar Solicitud de Tutor</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <form asp-action="RechazarSolicitud" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@s.Id" />
                        <div class="modal-body p-4">
                            <p class="text-muted small mb-3">
                                Se registrará el rechazo de la solicitud. Conforme a los lineamientos, el solicitante recibirá el aviso oficial:
                            </p>
                            <div class="alert alert-warning border-0 p-3 small mb-3">
                                <em>"Pasa a Coordinación para validar tu situación"</em>
                            </div>
                            <div class="bg-light p-3 rounded-3 small">
                                <div><strong>Solicitante:</strong> @s.NombreCompleto</div>
                                <div><strong>Boleta:</strong> @s.Boleta</div>
                                <div><strong>Modalidad:</strong> @s.ModalidadDescripcion</div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light border-0">
                            <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger btn-sm fw-semibold px-3">Confirmar y Rechazar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
    else if (s.Estado == EstadoSolicitud.Aprobada && s.EsTutorActivo)
    {
        <!-- Modal Suspender -->
        <div class="modal fade" id="modalSuspender_@s.UserId" tabindex="-1" aria-labelledby="labelSuspender_@s.UserId" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title fw-bold" id="labelSuspender_@s.UserId">Suspender Estatus de Tutor</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <form asp-action="SuspenderTutor" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@s.UserId" />
                        <div class="modal-body p-4">
                            <p class="text-muted small mb-3">
                                Esta acción revocará el rol de <strong>Tutor</strong> y despublicará automáticamente sus horarios y perfil académico del catálogo.
                            </p>
                            <div class="bg-light p-3 rounded-3 small">
                                <div><strong>Tutor:</strong> @s.NombreCompleto</div>
                                <div><strong>Boleta:</strong> @s.Boleta</div>
                                <div><strong>Modalidad actual:</strong> @s.ModalidadDescripcion</div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light border-0">
                            <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger btn-sm fw-semibold px-3">Confirmar Suspensión</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
