@model tutorias.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Registro Institucional IPN";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white text-center py-4 border-bottom-0">
                <h2 class="h4 fw-bold text-ipn-guinda mb-1">Sistema de Tutorías IPN</h2>
                <p class="text-muted small mb-0">Creación de cuenta institucional</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-medium"></label>
                        <input asp-for="Nombre" class="form-control form-control-lg" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="ApellidoPaterno" class="form-label fw-medium"></label>
                            <input asp-for="ApellidoPaterno" class="form-control form-control-lg" />
                            <span asp-validation-for="ApellidoPaterno" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="ApellidoMaterno" class="form-label fw-medium"></label>
                            <input asp-for="ApellidoMaterno" class="form-control form-control-lg" />
                            <span asp-validation-for="ApellidoMaterno" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Boleta" class="form-label fw-medium"></label>
                        <input asp-for="Boleta" class="form-control form-control-lg" />
                        <span asp-validation-for="Boleta" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-medium"></label>
                        <input asp-for="Email" class="form-control form-control-lg" />
                        
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-medium"></label>
                        <input asp-for="Password" class="form-control form-control-lg" type="password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-medium"></label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-lg" type="password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-ipn-guinda w-100 btn-lg fw-semibold">
                        Crear cuenta
                    </button>
                </form>
            </div>
            <div class="card-footer bg-white text-center py-3 border-top-0">
                <span class="text-muted small">¿Ya tienes una cuenta?</span>
                <a asp-action="Login" class="fw-semibold text-decoration-none ms-1 text-ipn-guinda">Iniciar sesión</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
