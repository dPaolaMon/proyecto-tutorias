@model tutorias.Models.ViewModels.DeleteProfileViewModel
@{
    ViewData["Title"] = "Baja de Perfil";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-danger text-white text-center py-4 rounded-top">
                <span class="fs-1 mb-2 d-block">⚠️</span>
                <h2 class="h4 fw-bold mb-1">Suspensión Perfil</h2>
                <p class="mb-0 small text-white-50">Suspender mi cuenta</p>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning border-0 small mb-4" role="alert">
                    <h6 class="fw-bold mb-1">Información importante sobre la suspensión:</h6>
                    <ul class="mb-0 ps-3">
                        <li>Tu cuenta quedará en estado <strong>desactivado</strong>.</li>
                        <li>No podrás iniciar sesión ni participar en tutorías ni registrar asistencias.</li>
                        <li>Tus registros institucionales previos se conservarán.</li>
                    </ul>
                </div>

                <form asp-action="DeleteProfile" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="MotivoBaja" class="form-label fw-medium"></label>
                        <textarea asp-for="MotivoBaja" class="form-control" rows="3"
                                  placeholder="Indica el motivo de la baja."></textarea>
                        <span asp-validation-for="MotivoBaja" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check p-3 bg-light rounded border">
                        <input asp-for="ConfirmarBaja" class="form-check-input ms-0 me-2" type="checkbox" required />
                        <label asp-for="ConfirmarBaja" class="form-check-label fw-semibold text-danger small">
                            Confirmo que deseo dar de baja mi cuenta y comprendo las consecuencias de la desactivación.
                        </label>
                        <span asp-validation-for="ConfirmarBaja" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger flex-grow-1 btn-lg fw-semibold">
                            Confirmar y Dar de Baja
                        </button>
                        <a asp-action="Profile" class="btn btn-outline-secondary btn-lg fw-semibold">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
