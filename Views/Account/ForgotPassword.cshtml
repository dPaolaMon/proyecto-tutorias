@model tutorias.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "¿Olvidaste tu contraseña?";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white text-center py-4 border-bottom-0">
                <div class="mb-2">
                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center bg-light text-ipn-guinda p-3 shadow-sm" style="width: 60px; height: 60px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-key" viewBox="0 0 16 16">
                            <path d="M0 8a4 4 0 0 1 7.465-2H14a.5.5 0 0 1 .354.146l1.5 1.5a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0L13 9.207l-.646.647a.5.5 0 0 1-.708 0L11 9.207l-.646.647a.5.5 0 0 1-.708 0L9 9.207l-.646.647A.5.5 0 0 1 8 10h-.535A4 4 0 0 1 0 8m4-3a3 3 0 1 0 2.712 4.285A.5.5 0 0 1 7.163 9h.63l.853-.854a.5.5 0 0 1 .708 0l.646.647.646-.647a.5.5 0 0 1 .708 0l.646.647.646-.647a.5.5 0 0 1 .708 0l1.147 1.147 1-1-1.147-1.147a.5.5 0 0 1-.146-.353V6.207l-.646-.647a.5.5 0 0 1-.708 0L11 5.793l-.646-.647a.5.5 0 0 1-.708 0L9 5.793l-.646-.647a.5.5 0 0 1-.708 0L7 5.793V5h-.837a.5.5 0 0 1-.45-.285A3 3 0 0 0 4 5"/>
                            <path d="M4 8a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
                        </svg>
                    </span>
                </div>
                <h2 class="h4 fw-bold text-ipn-guinda mb-1">Recuperar Contraseña</h2>
                <p class="text-muted small mb-0">Ingresa tu correo institucional registrado para recibir un enlace de restablecimiento.</p>
            </div>
            <div class="card-body p-4 pt-2">
                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-medium"></label>
                        <input asp-for="Email" class="form-control form-control-lg" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                        <div class="form-text small text-muted">Debe ser tu cuenta @@alumno.ipn.mx o @@ipn.mx.</div>
                    </div>

                    <button type="submit" class="btn btn-ipn-guinda w-100 btn-lg fw-semibold">
                        Enviar enlace de recuperación
                    </button>
                </form>
            </div>
            <div class="card-footer bg-white text-center py-3 border-top-0">
                <a asp-action="Login" class="fw-semibold text-decoration-none text-muted small">
                    &larr; Volver al inicio de sesión
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
