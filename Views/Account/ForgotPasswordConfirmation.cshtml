@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@{
    ViewData["Title"] = "Solicitud de Restablecimiento";
    var email = ViewBag.Email as string ?? "tu correo institucional";
    var devLink = ViewBag.DevLink as string;
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3 text-center p-4">
            <div class="card-body">
                <div class="mb-3">
                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center bg-light text-ipn-guinda p-3 shadow-sm" style="width: 72px; height: 72px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-shield-lock" viewBox="0 0 16 16">
                            <path d="M5.338 1.59a61 61 0 0 0-2.837.856.48.48 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.893.533q.18.085.293.118a1 1 0 0 0 .101.025 1 1 0 0 0 .1-.025q.114-.034.294-.118c.24-.113.546-.29.893-.533a10.7 10.7 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
                            <path d="M9.5 6.5a1.5 1.5 0 0 1-1 1.415l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99a1.5 1.5 0 1 1 1.993-1.415"/>
                        </svg>
                    </span>
                </div>

                <h2 class="h4 fw-bold text-ipn-guinda mb-2">Instrucciones enviadas</h2>
                <p class="text-muted mb-3">
                    Si el correo <strong>@email</strong> corresponde a una cuenta activa y verificada, hemos enviado un enlace para restablecer tu contraseña.
                </p>

                <div class="alert alert-light border small text-muted text-start mb-4">
                    <p class="mb-1 fw-medium text-dark">¿Qué sigue?</p>
                    <ul class="mb-0 ps-3">
                        <li>Revisa tu bandeja de entrada y sigue el enlace provisto.</li>
                        <li>Verifica tu carpeta de <strong>Correo no deseado (Spam)</strong>.</li>
                        <li>El enlace de restablecimiento expira por seguridad después de un periodo de tiempo.</li>
                    </ul>
                </div>

                @if (Environment.IsDevelopment() && !string.IsNullOrEmpty(devLink))
                {
                    <div class="alert alert-success border border-success p-3 text-start mb-4">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-success">Ambiente de Desarrollo</span>
                            <span class="small fw-semibold text-success">Simulador Local Activo</span>
                        </div>
                        <p class="small text-muted mb-2">
                            En entorno local puedes acceder al formulario de restablecimiento inmediatamente:
                        </p>
                        <a href="@devLink" class="btn btn-success w-100 fw-semibold shadow-sm">
                            [DEBUG] Restablecer contraseña inmediatamente
                        </a>
                    </div>
                }

                <div class="d-flex flex-column gap-2">
                    <a asp-action="Login" class="btn btn-ipn-guinda fw-semibold">
                        Regresar al inicio de sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
