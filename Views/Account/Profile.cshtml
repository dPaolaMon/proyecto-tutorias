@model tutorias.Models.ViewModels.ProfileViewModel
@using tutorias.Models
@{
    ViewData["Title"] = "Mi Perfil";

    string rolBadge = Model.Roles.Contains("Coordinador") ? "Coordinador" :
                      Model.Roles.Contains("Tutor")       ? "Tutor" :
                      Model.Roles.Contains("Docente")     ? "Docente" : "Alumno";

    string tipoTutorLabel = Model.TipoTutor switch
    {
        TipoTutor.AlumnoTutor  => "Alumno Tutor",
        TipoTutor.DocenteTutor => "Docente Tutor",
        _                      => string.Empty
    };
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6">

        @if (!Model.Activo)
        {
            <!-- Aviso de Cuenta en Baja y Botón de Reactivación -->
            <div class="alert alert-warning border-0 shadow-sm p-4 mb-4 rounded-3 text-center" role="alert">
                <span class="fs-1 d-block mb-2">⚠️</span>
                <h5 class="fw-bold text-dark mb-1">Tu cuenta se encuentra dada de baja</h5>
                <p class="small text-muted mb-3">
                    El acceso a las funciones del sistema está deshabilitado mientras tu perfil permanezca en baja. Puedes reactivar tu cuenta en cualquier momento haciendo clic en el siguiente botón.
                </p>
                <form asp-action="ReactivateProfile" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success btn-lg fw-semibold px-4 shadow-sm">
                        🔄 Reactivar mi cuenta
                    </button>
                </form>
            </div>
        }

        <!-- Tarjeta de Perfil -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">

            <!-- Encabezado con color institucional -->
            <div class="py-4 px-4 text-white text-center bg-ipn-guinda">
                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.FotoUrl))
                    {
                        <img src="@Model.FotoUrl" alt="Foto de perfil"
                             class="rounded-circle border border-white border-3 shadow-sm"
                             style="width:96px;height:96px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-white d-inline-flex align-items-center justify-content-center border border-white border-3 shadow-sm"
                             style="width:96px;height:96px;">
                            <span class="fw-bold text-ipn-guinda" style="font-size:2.4rem;">
                                @(string.IsNullOrWhiteSpace(Model.NombreCompleto) ? "?" : Model.NombreCompleto.Substring(0,1).ToUpper())
                            </span>
                        </div>
                    }
                </div>
                <h2 class="h5 fw-bold mb-1">@Model.NombreCompleto</h2>
                <div class="d-flex justify-content-center gap-2 flex-wrap mt-2">
                    <span class="badge rounded-pill bg-white text-ipn-guinda px-3 py-1 small fw-semibold">
                        @rolBadge @(!string.IsNullOrEmpty(tipoTutorLabel) ? $"— {tipoTutorLabel}" : "")
                    </span>
                    @if (Model.Activo)
                    {
                        <span class="badge rounded-pill bg-success text-white px-3 py-1 small fw-semibold">
                            ✓ Cuenta Activa
                        </span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-danger text-white px-3 py-1 small fw-semibold">
                            ✕ Cuenta en Baja Lógica
                        </span>
                    }
                </div>
            </div>

            <!-- Datos del perfil -->
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted small fw-semibold">Boleta / N° Empleado</dt>
                    <dd class="col-7 mb-3">@Model.Boleta</dd>

                    <dt class="col-5 text-muted small fw-semibold">
                        Correo Institucional
                        <span class="d-block small text-muted font-monospace">(Inmutable)</span>
                    </dt>
                    <dd class="col-7 mb-3 text-break">
                        <span class="fw-medium">@Model.Email</span>
                        <span class="badge bg-light text-secondary border ms-1 small">Fijo</span>
                    </dd>

                    @if (Model.EsDocente)
                    {
                        <dt class="col-5 text-muted small fw-semibold">Academia</dt>
                        <dd class="col-7 mb-3">
                            @(string.IsNullOrEmpty(Model.Academia) ? "— Sin asignar —" : Model.Academia)
                        </dd>
                    }
                    else
                    {
                        <dt class="col-5 text-muted small fw-semibold">Carrera</dt>
                        <dd class="col-7 mb-3">
                            @(string.IsNullOrEmpty(Model.CarreraNombre) ? "— Sin asignar —" : Model.CarreraNombre)
                        </dd>

                        <dt class="col-5 text-muted small fw-semibold">Semestre</dt>
                        <dd class="col-7 mb-3">
                            @(Model.Semestre.HasValue ? $"{Model.Semestre}° Semestre" : "—")
                        </dd>
                    }

                    <dt class="col-5 text-muted small fw-semibold">Estado del Perfil</dt>
                    <dd class="col-7 mb-3">
                        @if (Model.PerfilCompleto)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2">✓ Completo</span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2">⚠ Incompleto</span>
                        }
                    </dd>

                    @if (!Model.Activo && Model.FechaBaja.HasValue)
                    {
                        <dt class="col-5 text-danger small fw-semibold">Fecha de Baja</dt>
                        <dd class="col-7 mb-0 text-danger small">
                            @Model.FechaBaja.Value.ToLocalTime().ToString("g")
                            @if (!string.IsNullOrEmpty(Model.MotivoBaja))
                            {
                                <div class="text-muted small mt-1">Motivo: @Model.MotivoBaja</div>
                            }
                        </dd>
                    }
                </dl>
            </div>

            <!-- Acciones CRUD del Perfil -->
            <div class="card-footer bg-white border-top-0 px-4 pb-4 pt-0 d-flex gap-2 flex-wrap justify-content-between align-items-center">
                @if (Model.Activo)
                {
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-action="EditProfile" class="btn btn-ipn-guinda btn-sm fw-semibold">
                            ✏️ Editar Perfil
                        </a>
                        @if (!Model.PerfilCompleto)
                        {
                            <a asp-action="CompleteProfile" class="btn btn-outline-warning btn-sm fw-semibold">
                                Completar perfil
                            </a>
                        }
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold">
                            Volver
                        </a>
                    </div>
                    <div>
                        <button type="button" class="btn btn-outline-danger btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modalBajaCuenta" title="Dar de baja mi cuenta">
                            🗑️ Baja de Cuenta
                        </button>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2 w-100 justify-content-between align-items-center">
                        <form asp-action="ReactivateProfile" method="post" class="d-inline">
                            <button type="submit" class="btn btn-success btn-sm fw-semibold">
                                🔄 Reactivar mi cuenta
                            </button>
                        </form>
                        <form asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-secondary btn-sm fw-semibold">
                                🚪 Cerrar Sesión
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>

        @if (!Model.PerfilCompleto && Model.Activo)
        {
            <div class="alert alert-warning border-0 mt-3 d-flex align-items-center gap-2 small shadow-sm" role="alert">
                <span>⚠️</span>
                <span>Tu perfil está incompleto. Selecciona tu carrera para habilitar todas las funciones del sistema.</span>
            </div>
        }

    </div>
</div>

@if (Model.Activo)
{
    <!-- Modal de Confirmación de Baja de Cuenta -->
    <div class="modal fade" id="modalBajaCuenta" tabindex="-1" aria-labelledby="modalBajaLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="modalBajaLabel">⚠️ Confirmar Baja de Perfil</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form asp-action="DeleteProfile" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <p class="text-muted small mb-3">
                            Al dar de baja tu perfil, tu cuenta quedará desactivada y tus permisos suspendidos. Podrás reactivarla nuevamente en cualquier momento desde esta misma pantalla de perfil.
                        </p>
                        <div class="mb-3">
                            <label for="motivoBajaModal" class="form-label fw-medium small">Motivo de la baja (Opcional):</label>
                            <textarea id="motivoBajaModal" name="MotivoBaja" class="form-control" rows="2" placeholder="Indica el motivo de la baja..."></textarea>
                        </div>
                        <div class="form-check p-3 bg-light rounded border">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="confirmarBajaModal" name="ConfirmarBaja" value="true" required />
                            <label class="form-check-label text-danger fw-semibold small" for="confirmarBajaModal">
                                Confirmo que deseo dar de baja mi cuenta del Sistema de Tutorías.
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger btn-sm fw-semibold">Confirmar y Dar de Baja</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
