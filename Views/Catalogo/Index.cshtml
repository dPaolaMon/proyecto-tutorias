@model tutorias.Models.ViewModels.CatalogoFiltrosViewModel
@{
    ViewData["Title"] = "Catálogo de Tutorías Académicas";
}

<div class="container-fluid px-0 mb-5">
    <!-- Hero / Banner Institucional -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
        <div class="py-5 px-4 text-white text-center bg-ipn-guinda">
            <h1 class="h2 fw-bold mb-2">Catálogo de Tutorías Académicas</h1>
            <p class="mb-0 text-white-50 mx-auto" style="max-width: 650px;">
                Encuentra apoyo académico en UPIICSA. Consulta a los alumnos tutores y docentes tutores acreditados, sus materias y aulas de atención presencial.
            </p>
        </div>
    </div>

    <!-- Barra de Filtros Multicriterio -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <!-- Búsqueda por texto -->
                <div class="col-12 col-lg-4">
                    <label class="form-label small fw-bold text-muted mb-1">Buscar por Tutor, Materia o Salón:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search text-muted" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
                            </svg>
                        </span>
                        <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control border-start-0" placeholder="Ej. Juan Pérez, Cálculo, Salón C-1..." />
                    </div>
                </div>

                <!-- Filtro por Carrera -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label small fw-bold text-muted mb-1">Programa Académico / Carrera:</label>
                    <select name="carreraId" class="form-select">
                        <option value="">Todas las Carreras</option>
                        @foreach (var c in Model.CarrerasDisponibles)
                        {
                            <option value="@c.Id" selected="@(Model.CarreraId == c.Id)">@c.Nombre</option>
                        }
                    </select>
                </div>

                <!-- Filtro por Materia -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label small fw-bold text-muted mb-1">Unidad de Aprendizaje:</label>
                    <select name="materiaId" class="form-select">
                        <option value="">Todas las Materias</option>
                        @foreach (var m in Model.MateriasDisponibles)
                        {
                            <option value="@m.Id" selected="@(Model.MateriaId == m.Id)">@m.Clave - @m.Nombre</option>
                        }
                    </select>
                </div>

                <!-- Filtro por Modalidad -->
                <div class="col-12 col-sm-6 col-lg-2">
                    <label class="form-label small fw-bold text-muted mb-1">Modalidad:</label>
                    <select name="modalidad" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Modalidad))">Todas</option>
                        <option value="Pares" selected="@(Model.Modalidad == "Pares")">Tutoría entre Pares</option>
                        <option value="Docente" selected="@(Model.Modalidad == "Docente")">Tutoría Individual</option>
                    </select>
                </div>

                <!-- Botones -->
                <div class="col-12 d-flex gap-2 justify-content-end pt-1">
                    <button type="submit" class="btn btn-ipn-guinda fw-semibold px-4">
                        Aplicar Filtros
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || Model.CarreraId.HasValue || Model.MateriaId.HasValue || !string.IsNullOrWhiteSpace(Model.Modalidad))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary px-3" title="Limpiar filtros">
                            Limpiar
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Contador de Resultados -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 fw-bold text-dark mb-0">Tutores Disponibles</h2>
        <span class="small text-muted">@Model.TotalResultados resultado(s) encontrado(s)</span>
    </div>

    <!-- Resultados: Tutores en Cards Verticales -->
    @if (!Model.Tutores.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 text-center p-5 bg-white">
            <div class="py-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-search text-muted mb-3" viewBox="0 0 16 16">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
                </svg>
                <h5 class="fw-bold text-dark mb-1">No se encontraron tutores disponibles</h5>
                <p class="text-muted small mb-0">Intenta modificar los criterios de búsqueda o seleccionar otra carrera/materia.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var tutor in Model.Tutores)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <!-- CARD VERTICAL DEL TUTOR -->
                    <div class="card border-0 shadow-sm h-100 rounded-3 overflow-hidden d-flex flex-column justify-content-between">
                        <!-- Parte Superior: Avatar y Datos Principales -->
                        <div class="card-body p-4 text-center pb-2">
                            <div class="mb-3 d-flex justify-content-center">
                                @if (!string.IsNullOrEmpty(tutor.FotoUrl))
                                {
                                    <img src="@tutor.FotoUrl" alt="Foto de @tutor.NombreCompleto" class="rounded-circle border border-2 shadow-sm" style="width:84px;height:84px;object-fit:cover;"
                                         onerror="this.onerror=null; this.classList.add('d-none'); this.nextElementSibling.classList.remove('d-none');" />
                                    <div class="rounded-circle bg-ipn-guinda text-white d-inline-flex align-items-center justify-content-center fw-bold shadow-sm d-none" style="width:84px;height:84px;font-size:2.2rem;">
                                        @(string.IsNullOrWhiteSpace(tutor.NombreCompleto) ? "?" : tutor.NombreCompleto.Substring(0, 1).ToUpper())
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded-circle bg-ipn-guinda text-white d-inline-flex align-items-center justify-content-center fw-bold shadow-sm" style="width:84px;height:84px;font-size:2.2rem;">
                                        @(string.IsNullOrWhiteSpace(tutor.NombreCompleto) ? "?" : tutor.NombreCompleto.Substring(0, 1).ToUpper())
                                    </div>
                                }
                            </div>

                            <h5 class="fw-bold text-dark mb-1 text-truncate" title="@tutor.NombreCompleto">
                                @tutor.NombreCompleto
                            </h5>
                            <p class="small text-muted mb-2 text-truncate" title="@tutor.CarreraOAcademia">
                                @tutor.CarreraOAcademia
                            </p>

                            <!-- Badge de Modalidad -->
                            <div class="mb-2">
                                <span class="badge @(tutor.TipoTutor == tutorias.Models.TipoTutor.AlumnoTutor ? "bg-info-subtle text-info-emphasis border border-info-subtle" : "bg-primary-subtle text-primary border border-primary-subtle") px-3 py-1 fw-medium" style="font-size:0.75rem;">
                                    @tutor.ModalidadTitulo
                                </span>
                            </div>

                            <!-- Reputación -->
                            <div class="small mb-3">
                                <span class="text-warning fw-bold"><i class="bi bi-star-fill text-warning me-1"></i>@tutor.ReputacionPromedio.ToString("0.0")</span>
                                <span class="text-muted" style="font-size:0.75rem;">(Reputación)</span>
                            </div>

                            <!-- Materias que Imparte -->
                            <div class="text-start border-top pt-3">
                                <span class="text-muted small fw-semibold d-block mb-1" style="font-size:0.75rem;">Materias que imparte:</span>
                                @if (!tutor.MateriasNombres.Any())
                                {
                                    <span class="small text-muted fst-italic">Sin materias registradas</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var mat in tutor.MateriasNombres.Take(3))
                                        {
                                            <span class="badge bg-light text-dark border small text-truncate" style="max-width: 190px;" title="@mat">
                                                @mat
                                            </span>
                                        }
                                        @if (tutor.MateriasNombres.Count > 3)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary small">
                                                +@(tutor.MateriasNombres.Count - 3) más
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Pie de la Card: Botón a Detalle -->
                        <div class="card-footer bg-white border-top-0 p-3 pt-0 text-center">
                            <a asp-action="Detalle" asp-route-id="@tutor.PerfilId" class="btn btn-ipn-guinda btn-sm fw-semibold w-100 shadow-sm py-2">
                                Ver Detalle y Horarios &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Paginación -->
        @if (Model.TotalPaginas > 1)
        {
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4 bg-white p-3 rounded-3 shadow-sm border">
                <span class="small text-muted">
                    Página @Model.PaginaActual de @Model.TotalPaginas (Total: @Model.TotalResultados tutores)
                </span>
                <nav aria-label="Navegación del catálogo">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pagina="@(Model.PaginaActual - 1)"
                               asp-route-busqueda="@Model.Busqueda"
                               asp-route-carreraId="@Model.CarreraId"
                               asp-route-materiaId="@Model.MateriaId"
                               asp-route-modalidad="@Model.Modalidad">Anterior</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPaginas; p++)
                        {
                            <li class="page-item @(p == Model.PaginaActual ? "active" : "")">
                                <a class="page-link @(p == Model.PaginaActual ? "bg-ipn-guinda border-0" : "")"
                                   asp-action="Index"
                                   asp-route-pagina="@p"
                                   asp-route-busqueda="@Model.Busqueda"
                                   asp-route-carreraId="@Model.CarreraId"
                                   asp-route-materiaId="@Model.MateriaId"
                                   asp-route-modalidad="@Model.Modalidad">@p</a>
                            </li>
                        }
                        <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pagina="@(Model.PaginaActual + 1)"
                               asp-route-busqueda="@Model.Busqueda"
                               asp-route-carreraId="@Model.CarreraId"
                               asp-route-materiaId="@Model.MateriaId"
                               asp-route-modalidad="@Model.Modalidad">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>
