# Configuración de variables sensibles locales (IGNORADO POR GIT)
MSSQL_SA_PASSWORD=Toor

# Azure Communication Services (Opcional en desarrollo local, obligatorio en producción)
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING=
EMAIL_SENDER_ADDRESS=DoNotReply@<tu-dominio>.azurecomm.net

# Simulación de fecha y hora (hora de México) para pruebas de horarios de tutoría. Opcional.
# Formato: YYYY-MM-DDTHH:mm:ss. Solo funciona con ASPNETCORE_ENVIRONMENT=Development.
# El reloj avanza desde esa fecha y vuelve a ella cada vez que se reinicia la aplicación.
FECHA_SIMULADA_DEV=